# 蓝湖认证 Cookie（必需）
# 获取方式：登录蓝湖网页版 → F12 开发者工具 → Network → 复制 Cookie
LANHU_COOKIE=your_lanhu_cookie_here

# 可选：Authorization Token（部分接口需要，从 Request Headers 中复制 Authorization 整行值）
# LANHU_AUTHORIZATION=Basic ZXlKaGJHc...

# 可选：租户 ID（从任意 API 请求 body 中的 tenantId 获取）
# LANHU_TENANT_ID=ba722a59-4856-4b06-adcd-5584f7b57356

# 可选：项目 ID（从蓝湖项目 URL 中获取，如 /project/xxxxx）
# LANHU_PROJECT_ID=your_project_id
