{
  "name": "dc-lanhu-mcp-server",
  "version": "1.3.0",
  "description": "蓝湖 MCP Server — 让 AI 编程工具直接读取蓝湖设计稿数据，实现 Design to Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dc-lanhu-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/dev-server.*",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx tests/utils.test.ts && npx tsx tests/security.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lanhu",
    "design-to-code",
    "claude",
    "cursor",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DC911360/lanhu-mcp-server.git"
  },
  "homepage": "https://github.com/DC911360/lanhu-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DC911360/lanhu-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "zod": "^3.24.4"
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
